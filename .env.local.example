# Copy to .env.local and fill in. Never commit the real values.

# Airtable Personal Access Token.
# Create one at https://airtable.com/create/tokens with these scopes:
#   data.records:read, data.records:write, schema.bases:read
# Give it access to only the MiTea base (app9kUOoO7zjSt4nU).
AIRTABLE_API_KEY=

# The base ID (starts with "app"), from the Airtable URL when viewing the base.
AIRTABLE_BASE_ID=app9kUOoO7zjSt4nU

# A long random string used to sign login session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Set to 1 to show the brand preset switcher in the corner. Never in production.
NEXT_PUBLIC_SHOW_THEME_PICKER=
